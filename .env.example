# ============================================================
# 星罗授权管理系统 环境变量样例
# 用法：cp .env.example .env ，然后按需修改；docker compose 会自动加载
# 注意：.env 已被 .gitignore 忽略，不会提交到仓库
# ============================================================

# ---------- 数据库（MySQL 8.0） ----------
# 仅首次初始化数据卷时生效，修改后需删除旧卷重建：docker compose down -v
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=auth_system
# 留空则使用 root 账号连接；填写后镜像会自动创建该专用账号并授予库权限
MYSQL_USER=
MYSQL_PASSWORD=

# 后端实际读取的数据库连接参数（默认值与上方保持一致即可）
DB_HOST=db
DB_PORT=3306
DB_NAME=auth_system
DB_USER=root
DB_PASS=change-me-root-password

# ---------- 应用 ----------
# true=开发模式（邮件失败返回模拟验证码、输出SMTP日志）；生产环境必须 false
APP_DEBUG=true
# 跨域来源，生产环境改成自己的前端域名，如 https://auth.example.com
CORS_ALLOW_ORIGIN=*

# ---------- SMTP 邮件（QQ邮箱验证码） ----------
# 163 邮箱示例；QQ邮箱请填 smtp.qq.com / 465 / ssl
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
# 发信邮箱账号
MAIL_USERNAME=your_mailbox@163.com
# SMTP 授权码（在邮箱后台开启SMTP后生成，不是登录密码！）
MAIL_PASSWORD=your_smtp_auth_code
# 发件人地址，通常与账号一致
MAIL_FROM=your_mailbox@163.com
# 生产环境保持 true 校验服务器证书
MAIL_VERIFY_SSL=true
